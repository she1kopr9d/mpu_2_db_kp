<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.kafedra.controller.WorkloadDialogController">
    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
    <Label text="Добавление нагрузки" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
    <GridPane hgap="10.0" vgap="10.0">
        <Label text="Преподаватель:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <ComboBox fx:id="_teacherCombo" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        
        <Label text="Группа:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <ComboBox fx:id="_groupCombo" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        
        <Label text="Норматив:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <ComboBox fx:id="_standardCombo" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        
        <Label text="Часы:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="_hoursField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
    </GridPane>
    <HBox spacing="10.0" alignment="CENTER">
        <Button onAction="#handleSave" text="Сохранить" prefWidth="100.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
        <Button onAction="#handleCancel" text="Отмена" prefWidth="100.0" />
    </HBox>
</VBox>